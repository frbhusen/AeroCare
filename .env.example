# Copy to .env for local development. Never commit real secrets.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Runtime role: NOT superuser, NOBYPASSRLS, not table owner.
DATABASE_URL=postgresql+psycopg://hc_app@127.0.0.1:55432/healthcenter_dev
# Schema owner role, used only by `flask --app backend.wsgi db init-schema`.
SCHEMA_DATABASE_URL=postgresql+psycopg://hc_schema@127.0.0.1:55432/healthcenter_dev
TEST_DATABASE_URL=postgresql+psycopg://hc_app@127.0.0.1:55432/healthcenter_test
TEST_SCHEMA_DATABASE_URL=postgresql+psycopg://hc_schema@127.0.0.1:55432/healthcenter_test
STORAGE_ROOT=./storage
BACKUP_ROOT=./backups
LOG_DIR=./logs
# Production only:
# SESSION_COOKIE_SECURE=1
# PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
