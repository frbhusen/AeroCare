[Unit]
Description=AeroCare - Health Center Management Platform (Gunicorn)
After=network.target postgresql.service

[Service]
User=aerocare
Group=aerocare
WorkingDirectory=/opt/aerocare/app
EnvironmentFile=/etc/aerocare/aerocare.env
ExecStart=/opt/aerocare/venv/bin/gunicorn -c deploy/gunicorn.conf.py backend.wsgi:app
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/aerocare /var/log/aerocare
UMask=0027

[Install]
WantedBy=multi-user.target
