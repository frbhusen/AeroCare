# /etc/aerocare/aerocare.env — owner root:aerocare, mode 640 (systemd reads it as root; the aerocare
# user must be able to read it for CLI commands such as init-schema and backups). Never commit real values.

# --- required -------------------------------------------------------------------------------------
FLASK_ENV=production
SECRET_KEY=<64+ random chars: python3 -c "import secrets;print(secrets.token_urlsafe(64))">
# Runtime role (data only, NOBYPASSRLS). URL-encode special characters in passwords.
DATABASE_URL=postgresql+psycopg://hc_app:<password>@127.0.0.1:5432/aerocare
# Schema owner: used by `flask db init-schema` and by full backups (pg_dump).
SCHEMA_DATABASE_URL=postgresql+psycopg://hc_schema:<password>@127.0.0.1:5432/aerocare

# --- paths ----------------------------------------------------------------------------------------
STORAGE_ROOT=/var/lib/aerocare/storage
BACKUP_ROOT=/var/lib/aerocare/backups
LOG_DIR=/var/log/aerocare

# --- HTTPS / sessions -----------------------------------------------------------------------------
SESSION_COOKIE_SECURE=1          # cookies only over HTTPS (keep 1 in production)
SESSION_IDLE_DAYS=30             # sign out sessions unused this many days (0 = never)
SESSION_MAX_AGE_DAYS=365
SERVE_FRONTEND=0                 # Nginx serves web/; Flask only serves /api

# --- database pool / gunicorn ---------------------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# (workers x (pool + overflow)) must stay below PostgreSQL max_connections (default 100).
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# --- PDFs (Arabic needs a font with Arabic glyphs; DejaVu has them: apt install fonts-dejavu-core) --
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
PDF_FONT_BOLD_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# --- optional -------------------------------------------------------------------------------------
# PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump   # if pg_dump on PATH is older than the server
# LOGIN_RATE_LIMIT=10                          # failed logins per 15 min per email/IP
# UNDO_WINDOW_SECONDS=30
