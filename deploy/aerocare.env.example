# /etc/aerocare/aerocare.env  (chmod 600, owner root:aerocare)
FLASK_ENV=production
SECRET_KEY=<64+ random chars: python3 -c "import secrets;print(secrets.token_urlsafe(64))">
DATABASE_URL=postgresql+psycopg://hc_app:<password>@127.0.0.1:5432/aerocare
SCHEMA_DATABASE_URL=postgresql+psycopg://hc_schema:<password>@127.0.0.1:5432/aerocare
STORAGE_ROOT=/var/lib/aerocare/storage
BACKUP_ROOT=/var/lib/aerocare/backups
LOG_DIR=/var/log/aerocare
SESSION_COOKIE_SECURE=1
SERVE_FRONTEND=0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
