# /etc/healthcenter/healthcenter.env  (chmod 600, owner root:healthcenter)
FLASK_ENV=production
SECRET_KEY=<64+ random chars: python3 -c "import secrets;print(secrets.token_urlsafe(64))">
DATABASE_URL=postgresql+psycopg://hc_app:<password>@127.0.0.1:5432/healthcenter
SCHEMA_DATABASE_URL=postgresql+psycopg://hc_schema:<password>@127.0.0.1:5432/healthcenter
STORAGE_ROOT=/var/lib/healthcenter/storage
BACKUP_ROOT=/var/lib/healthcenter/backups
LOG_DIR=/var/log/healthcenter
SESSION_COOKIE_SECURE=1
SERVE_FRONTEND=0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
